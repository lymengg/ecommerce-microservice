<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>com.ecommerce</groupId>
    <artifactId>ecommerce-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ecommerce</name>
    <description>E-commerce platform — multi-module microservices (Phase 3: service extraction)</description>

    <modules>
        <module>common</module>
        <module>catalog-service</module>
        <module>cart-service</module>
        <module>inventory-service</module>
        <module>order-service</module>
        <module>payment-service</module>
        <module>checkout-service</module>
        <module>gateway-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.17</springdoc.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <wiremock.version>3.9.1</wiremock.version>
        <otel.agent.version>2.31.1</otel.agent.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ecommerce</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Tracing (Phase 5, ADR-014). Attaches the pinned OpenTelemetry
                     Java agent to `mvn spring-boot:run`.

                     The agent does bytecode instrumentation, so it also handles
                     context propagation (Apache HttpClient 5) and log correlation
                     (Logback MDC) with no application code. -Dotel.service.name
                     resolves per module, so each service reports its artifactId.

                     Note this only affects `spring-boot:run`: surefire and
                     failsafe fork their own JVMs, so unit and integration tests
                     run without the agent and stay fast. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <jvmArguments>-javaagent:${maven.multiModuleProjectDirectory}/otel/opentelemetry-javaagent.jar -Dotel.service.name=${project.artifactId} -Dotel.exporter.otlp.endpoint=http://localhost:4317 -Dotel.exporter.otlp.protocol=grpc -Dotel.traces.exporter=otlp -Dotel.metrics.exporter=none -Dotel.logs.exporter=none -Dotel.propagators=tracecontext,baggage -Dotel.traces.sampler=parentbased_always_on -Dotel.resource.attributes=deployment.environment=local</jvmArguments>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Fetches the pinned OpenTelemetry Java agent into otel/ at the repo
                 root, so the agent version is part of the build rather than a
                 manual download. `inherited=false` keeps it to the root project:
                 otherwise all seven services would copy the same ~20 MB jar.

                 Because this is phase-bound, running a single service straight
                 from a clean clone needs a root build first (`./mvnw -N validate`).
                 See README "Run (full stack locally)". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>fetch-otel-javaagent</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifact>io.opentelemetry.javaagent:opentelemetry-javaagent:${otel.agent.version}</artifact>
                            <outputDirectory>${maven.multiModuleProjectDirectory}/otel</outputDirectory>
                            <!-- stripVersion yields opentelemetry-javaagent.jar,
                                 which is the stable path the -javaagent argument
                                 above points at. dependency:copy has no
                                 destFileName parameter. -->
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
