<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecommerce</groupId>
        <artifactId>ecommerce-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>
    <name>common</name>
    <description>Shared library: RFC 9457 error handling, transactional outbox (ADR-009), REST client helpers</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- Resilience4j (Phase 7, ADR-017). Core modules only, not
             resilience4j-spring-boot3: the starter binds its own
             `resilience4j.*` namespace and builds one global registry, whereas
             this project needs per-dependency instances driven from
             `ecommerce.resilience.*` and wired through an auto-configuration so
             checkout-service (which scans selectively) gets them too. Versions
             come from the Spring Cloud BOM imported in the parent. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-bulkhead</artifactId>
        </dependency>
        <!-- Optional: binds breaker/retry/bulkhead metrics to a Micrometer
             registry when one is present. No service has Actuator yet (Phase 8
             adds it), so this is inert today and lights up automatically once a
             MeterRegistry exists. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenTelemetry API for manual instrumentation (CorrelationIdFilter,
             the checkout saga span). The Java agent supplies the implementation
             at runtime; without the agent these calls are no-ops. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <!-- optional: consumers with a database declare the starter themselves -->
            <optional>true</optional>
        </dependency>
        <!-- Spring for Apache Kafka (Phase 6, ADR-004/015). Optional: only the
             services that actually publish or consume events declare it, so
             catalog/cart/checkout never open a broker connection. The messaging
             auto-configuration is guarded by @ConditionalOnClass(KafkaTemplate)
             and therefore activates only where this starter is present. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
