{
  "realm": "ecommerce",
  "displayName": "E-Commerce Platform",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "End customer" },
      { "name": "ADMIN", "description": "Administrator" },
      { "name": "SERVICE", "description": "Service-to-service identity (client credentials)" }
    ]
  },
  "clients": [
    {
      "clientId": "web-app",
      "name": "Web application (SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "fullScopeAllowed": true,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "service-client",
      "name": "Service-to-service client (client credentials)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-service-client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["service_account", "web-origins", "acr", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "test-client",
      "name": "Development/test client (password grant)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-test-client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    }
  ],
  "users": [
    {
      "username": "customer1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "One",
      "email": "customer1@example.com",
      "credentials": [{ "type": "password", "value": "customer1-password" }],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "customer2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "Two",
      "email": "customer2@example.com",
      "credentials": [{ "type": "password", "value": "customer2-password" }],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "email": "admin1@example.com",
      "credentials": [{ "type": "password", "value": "admin1-password" }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "service-account-service-client",
      "enabled": true,
      "serviceAccountClientId": "service-client",
      "realmRoles": ["SERVICE"]
    }
  ]
}
