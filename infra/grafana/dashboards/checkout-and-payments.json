{
  "uid": "ecommerce-checkout",
  "title": "Checkout and payments",
  "description": "The money path: what customers did, what the provider said, what stock did, and what reconciliation had to clean up. Business outcomes are separated from system errors throughout — that separation is the reason these series exist at all.",
  "tags": ["ecommerce", "business"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Checkout success rate (1h)",
      "description": "paid / all checkout attempts. Read it next to the error rate: a decline-driven drop is a business event, not an outage.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.99 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(checkout_saga_outcomes_total{outcome=\"paid\"}[1h])) / sum(increase(checkout_saga_outcomes_total[1h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Orders placed (1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(orders_placed_total[1h]))" }
      ]
    },
    {
      "type": "stat",
      "title": "Orders needing a human",
      "description": "Reconciliation gave up on these: they are in NEEDS_ATTENTION. Anything above zero is a real to-do, not noise.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(reconciliation_orders_total{outcome=\"needs_attention\"}[24h]))" }
      ]
    },
    {
      "type": "stat",
      "title": "Events stuck in the outbox",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 300 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "max(outbox_events_oldest_unpublished_age_seconds)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkout outcomes over time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (rate(checkout_saga_outcomes_total[5m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Payment outcomes (provider view)",
      "description": "doc 08 §4 \"payment success/failure\". A spike in FAILED is the provider declining — a business fact, which is why the alert on it is labelled kind=business.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (rate(payments_outcomes_total[5m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Inventory reservation outcomes",
      "description": "doc 08 §4 \"inventory reservation failures\". `insufficient_stock` climbing is demand outrunning stock, and it is also the signal that checkout is about to start compensating.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (rate(inventory_reservations_total[5m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reconciliation outcomes (Phase 7's safety net, finally observable)",
      "description": "completed = the payment had succeeded and the order was repaired; compensated = no payment, so stock was released and the order cancelled; deferred = looked again later; needs_attention = gave up, a human must look.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{outcome}} (per pass)", "expr": "sum by (outcome) (rate(reconciliation_orders_total[10m]))" }
      ]
    },
    {
      "type": "logs",
      "title": "Reconciliation and checkout decisions",
      "description": "The decisions behind the counters above, with trace_id attached so each one opens its trace.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\"order-service|checkout-service\"} |~ \"(?i)reconcil|compensat|declined\""
        }
      ]
    }
  ]
}
